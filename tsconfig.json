{
  // Type checking only (`pnpm typecheck`). tsdown builds `dist/` from
  // src/index.ts, using this file for the declarations.
  "compilerOptions": {
    // The library targets ES2022 runtimes (see tsdown.config.ts), but its
    // types may use the ESNext lib: the native Iterator helpers are detected
    // at runtime and polyfilled where missing.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Source files import each other with the `.ts` extension, and must stay
    // plain type-strippable TypeScript.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  // The examples have their own tsconfig and TypeScript version, and check
  // the built package the way a consumer's project would.
  "exclude": ["node_modules", "dist", "coverage", "examples"]
}
