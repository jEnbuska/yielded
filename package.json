{
  "name": "@jenbuska/yielded",
  "version": "2.1.0",
  "description": "A TypeScript library for composing and transforming values from synchronous iterables and asynchronous generators through a uniform, lazy-evaluated pipeline API",
  "keywords": [
    "iterator",
    "iterable",
    "generator",
    "async",
    "lazy",
    "pipeline",
    "stream",
    "functional",
    "typescript",
    "parallel"
  ],
  "author": "jEnbuska",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jEnbuska/yielded.git"
  },
  "bugs": {
    "url": "https://github.com/jEnbuska/yielded/issues"
  },
  "homepage": "https://github.com/jEnbuska/yielded#readme",
  "type": "module",
  "engines": {
    "node": ">=20.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "publish:beta": "pnpm publish --tag beta --access public",
    "test": "vitest run && USE_POLYFILLS=true vitest run",
    "test:watch": "vitest",
    "test:examples": "pnpm run test:example:node && pnpm run test:example:react",
    "test:example:node": "pnpm run build && pnpm --filter node-ts-example run build",
    "test:example:react": "pnpm run build && pnpm --filter react-vite-example test",
    "lint": "oxlint",
    "check-all": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:examples",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip --reporter symbols --reporter ./scripts/knip-explain.mts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "knip": "^6.48.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
